{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "default": {
            "format": "%(asctime)s - %(levelname)s %(message)s",
            "datefmt": "%Y-%m-%d %H:%M:%S"
        }
    },
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "formatter": "default"
        }
    },
    "root": {
        "level": "INFO",
        "handlers": ["console"]
    },
    "loggers": {
        "uvicorn": {
            "handlers": ["console"],
            "level": "INFO",
            "propagate": false
        },
        "uvicorn.error": {
            "level": "INFO",
            "handlers": ["console"],
            "propagate": false
        },
        "uvicorn.access": {
            "level": "INFO",
            "handlers": ["console"],
            "propagate": false
        },
        "backend": {
            "level": "INFO",
            "handlers": ["console"],
            "propagate": false
        },
        "watchfiles": {
            "level": "WARNING",
            "handlers": ["console"],
            "propagate": false
        },
        "watchfiles.main": {
            "level": "WARNING",
            "handlers": ["console"],
            "propagate": false
        }
    }
}
